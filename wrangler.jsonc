{
  // Cloudflare Workers static site for https://sharingan.poker (serves ./site)
  "name": "sharingan",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./site", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "sharingan.poker", "custom_domain": true },
    { "pattern": "www.sharingan.poker", "custom_domain": true }
  ]
}
